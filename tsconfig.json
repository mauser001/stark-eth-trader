{
    "compilerOptions": {
      "module": "commonjs",
      "esModuleInterop": true,
      "target":"ES2023",
      "moduleResolution": "node",
      "sourceMap": false,
      "outDir": "./dist",
      "rootDir": "./src",
      "lib": [
        "es2023"
      ],
      "resolveJsonModule": true,
      "isolatedModules": true,
      "allowJs": true,
      "skipLibCheck": true
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "./dist",
      "./webapp"
    ]
  }